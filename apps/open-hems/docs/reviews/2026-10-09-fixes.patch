+    p05, p95 = [round(float(t0_c), 2)], [round(float(t0_c), 2)]
+    demand_p50: List[float] = []
+    c05 = c95 = float(t0_c)
+    for k, s in enumerate(slots):
+        dt_val = getattr(s, "dt", None) or (datetime.now(timezone.utc) + timedelta(minutes=15 * k))
