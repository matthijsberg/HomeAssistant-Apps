# Environment overrides for local development (never commit a real .env)
KICAD_MCP_WORKSPACE_ROOT=/tmp/kicad-workspace
KICAD_MCP_ALLOWED_ROOTS=/tmp/kicad-workspace
KICAD_MCP_READ_ONLY=false
KICAD_MCP_BEARER_TOKEN=change-me-dev-token
KICAD_MCP_LOG_LEVEL=info
KICAD_MCP_HOST=127.0.0.1
KICAD_MCP_PORT=8000
